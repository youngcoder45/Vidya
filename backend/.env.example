# ============================================================================
# Vidya API — environment configuration
# Copy to .env and adjust. All values are prefixed APP_.
# ============================================================================

APP_ENV=local                      # local | staging | production
APP_PORT=8080
APP_LOG_LEVEL=info

# --- PostgreSQL ---
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=vidya
APP_DB_PASSWORD=vidya
APP_DB_NAME=vidya
APP_DB_SSLMODE=disable

# --- Redis ---
APP_REDIS_ADDR=localhost:6379
APP_REDIS_PASSWORD=
APP_REDIS_DB=0

# --- Auth ---
# >= 32 chars in production
APP_JWT_SECRET=dev-secret-change-me-0123456789abcdef
APP_JWT_ACCESS_TTL=15m
APP_JWT_REFRESH_TTL=720h          # 30 days

# --- Encryption (PII at rest) ---
# 32-byte AES key; required in production. Generate: openssl rand -hex 32
APP_ENC_KEY=

# --- Razorpay (online fees) ---
APP_RAZORPAY_KEY_ID=
APP_RAZORPAY_KEY_SECRET=
APP_RAZORPAY_WEBHOOK_SECRET=

# --- CORS ---
APP_CORS_ORIGINS=*

# --- Rate limiting ---
APP_RATE_LIMIT_PER_MIN=120
APP_AUTH_RATE_LIMIT_PER_MIN=5

# --- Migrations ---
# Production only: apply versioned SQL migrations at boot. Keep off in local,
# where GORM AutoMigrate owns the schema.
APP_MIGRATE_ON_START=false
APP_MIGRATIONS_DIR=migrations

# --- Dev ---
APP_SEED_ON_START=true            # seeds roles/permissions + demo school (local only)
